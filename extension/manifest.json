{
    "manifest_version": 3,
    "name": "MYYT - Auto Skip YouTube Ads",
    "version": "1.1.1",
    "description": "YouTube'da 'Reklamı geç' butonu aktif olduğunda otomatik tıklar (trusted click desteği ile).",
    "permissions": [
        "debugger",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["bridge.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ]
}
